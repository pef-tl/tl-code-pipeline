# Image du worker code-pipeline pour déploiement managé Mistral (build depuis
# un miroir GitHub) ou self-hosted (build par la CI GitLab, push sur le
# Container Registry, déploiement via le Helm chart Mistral).
#
# Variables d'environnement requises au boot (fournies par la plateforme en
# managé, ou par le Helm chart / le run docker en self-hosted). Convention :
# toutes les variables du pipeline sont en MINUSCULES :
#   DEPLOYMENT_NAME      — requis : nom du déploiement (routage des exécutions)
#   MISTRAL_API_KEY      — nom réservé (majuscules) injecté par le runtime
#                          managé ; le code lit `mistral_api_key` en priorité
#                          avec fallback sur MISTRAL_API_KEY. En self-hosted,
#                          définir `mistral_api_key`.
#   gitlab_token         — clone/push/Merge Requests sur les repos cibles GitLab
#   approval_webhook_url — notification des gates humaines (webhook...)
#   pipeline_workspace   — dossier de clone des repos cibles (défaut /tmp/...)

FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml ./
COPY apps/worker/src ./apps/worker/src
RUN uv pip install --system .

ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "worker.entrypoints.worker"]
